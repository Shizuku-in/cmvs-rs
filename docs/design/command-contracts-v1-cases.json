{
  "schema": "cmvs-contract-test-vectors-v1",
  "synthetic_only": true,
  "status": "M0 expectations; no extractor or comparator implemented",
  "application": "Deep-copy contract, apply base_changes to both sides, then derived_changes to derived only. Changes use replace-only JSON Pointer paths; list indices are decimal. extraction/evidence_change are scenario requirements for the future harness, not accepted production evidence.",
  "contract": {
    "precondition": [
      "bool",
      true
    ],
    "parameters": [
      {
        "id": "flag",
        "stack_offset": -4,
        "width": 32,
        "interpretation": "unsigned"
      }
    ],
    "tree": {
      "kind": "leaf",
      "events": [
        {
          "id": "p0",
          "op": "read_parameter",
          "parameter": "flag"
        },
        {
          "id": "w0",
          "op": "write_state",
          "target": {
            "region": "object",
            "object": "receiver",
            "field": "flags"
          },
          "width": 32,
          "value": [
            "arg",
            "flag"
          ]
        },
        {
          "id": "s0",
          "op": "release_stack",
          "bytes": 4
        }
      ],
      "exit": {
        "kind": "return",
        "code": [
          "bv",
          32,
          "00004004"
        ]
      }
    },
    "coverage": {
      "cfg_closed": true,
      "effects_closed": true,
      "calls_closed": true,
      "memory_closed": true,
      "domain_closed": true,
      "issues": []
    }
  },
  "cases": [
    {
      "id": "identical",
      "expected": "equivalent",
      "derived_changes": [],
      "rationale": "相同完整契约；只是合成模型，不是生产证据。"
    },
    {
      "id": "mapped-layout",
      "expected": "equivalent",
      "derived_changes": [],
      "rationale": "双边偏移经已验证映射归为同一逻辑字段；原始偏移不进入语义体。",
      "extraction": {
        "base_offset": "0x180",
        "derived_offset": "0x250",
        "mapping": "valid-synthetic",
        "expected_issue": null
      }
    },
    {
      "id": "unmapped-layout",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/memory_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "unproven-mapping"
          ]
        }
      ],
      "rationale": "相似写入不能自行证明字段身份。",
      "extraction": {
        "base_offset": "0x180",
        "derived_offset": "0x250",
        "mapping": null,
        "expected_issue": "unproven-mapping"
      }
    },
    {
      "id": "return-code",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/exit/code",
          "value": [
            "bv",
            32,
            "00004000"
          ]
        }
      ],
      "rationale": "同一输入得到不同返回码。",
      "witness": {
        "flag": "00000000"
      }
    },
    {
      "id": "cleanup-independent",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/2/bytes",
          "value": 12
        }
      ],
      "rationale": "参数读取不变，回收从4变为12字节。",
      "witness": {
        "flag": "00000000"
      }
    },
    {
      "id": "different-field",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/1/target/field",
          "value": "other_flags"
        }
      ],
      "rationale": "相同值写入另一可见字段。",
      "witness": {
        "flag": "00000001",
        "initial.flags": "00000000",
        "initial.other_flags": "00000000"
      }
    },
    {
      "id": "different-value",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/1/value",
          "value": [
            "add",
            [
              "arg",
              "flag"
            ],
            [
              "bv",
              32,
              "00000001"
            ]
          ]
        }
      ],
      "rationale": "相同字段写入arg+1。",
      "witness": {
        "flag": "00000000"
      }
    },
    {
      "id": "different-mask",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/1/value",
          "value": [
            "and",
            [
              "arg",
              "flag"
            ],
            [
              "bv",
              32,
              "fffffffe"
            ]
          ]
        }
      ],
      "rationale": "清掉最低位属于可观察差异。",
      "witness": {
        "flag": "00000001"
      }
    },
    {
      "id": "missing-cfg",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/cfg_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "cfg-gap"
          ]
        }
      ],
      "rationale": "缺失分支不能视为无效果。"
    },
    {
      "id": "unresolved-call",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/calls_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "unresolved-call"
          ]
        }
      ],
      "rationale": "同形间接调用仍可能隐藏效果。",
      "base_changes": [
        {
          "op": "replace",
          "path": "/coverage/calls_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "unresolved-call"
          ]
        }
      ]
    },
    {
      "id": "unknown-alias",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/memory_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "pointer-escape"
          ]
        }
      ],
      "rationale": "逃逸对象可能被未建模调用修改。"
    },
    {
      "id": "omitted-helper-effects",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/effects_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "unsupported-effect"
          ]
        }
      ],
      "rationale": "有未建模副作用时不能信任摘要表面相同。"
    },
    {
      "id": "budget",
      "expected": "unknown",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/coverage/cfg_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "budget-exceeded"
          ]
        }
      ],
      "rationale": "同样截断不产生完整证据。"
    },
    {
      "id": "narrowed-domain",
      "expected": "invalid-input",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/precondition",
          "value": [
            "eq",
            [
              "arg",
              "flag"
            ],
            [
              "bv",
              32,
              "00000000"
            ]
          ]
        },
        {
          "op": "replace",
          "path": "/coverage/domain_closed",
          "value": false
        },
        {
          "op": "replace",
          "path": "/coverage/issues",
          "value": [
            "unsupported-expression"
          ]
        }
      ],
      "rationale": "M1不接受缩小输入域；此表达式在入口尚未读取参数，校验应拒绝。"
    },
    {
      "id": "unknown-op",
      "expected": "invalid-input",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/1/op",
          "value": "ignore_memory"
        }
      ],
      "rationale": "未知IR事件拒绝输入，不得当成无操作。"
    },
    {
      "id": "bad-width",
      "expected": "invalid-input",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/events/1/width",
          "value": 24
        }
      ],
      "rationale": "v1仅接受8/16/32/64位。"
    },
    {
      "id": "missing-proof",
      "expected": "invalid-evidence",
      "derived_changes": [],
      "rationale": "语义相同但真实输入缺少身份或映射证明。",
      "evidence_change": "remove mapping_sha256"
    },
    {
      "id": "stale-summary",
      "expected": "invalid-evidence",
      "derived_changes": [],
      "rationale": "helper函数体哈希与摘要绑定不符。",
      "evidence_change": "mismatch body_sha256"
    },
    {
      "id": "cross-arch",
      "expected": "invalid-evidence",
      "derived_changes": [],
      "rationale": "M1只接受同架构x64构建对。",
      "evidence_change": "derived arch=x86"
    },
    {
      "id": "swapped-returns",
      "expected": "different",
      "derived_changes": [
        {
          "op": "replace",
          "path": "/tree/then/exit/code",
          "value": [
            "bv",
            32,
            "0000400c"
          ]
        },
        {
          "op": "replace",
          "path": "/tree/else/exit/code",
          "value": [
            "bv",
            32,
            "00004000"
          ]
        }
      ],
      "rationale": "返回集合相同但条件对应相反。",
      "base_changes": [
        {
          "op": "replace",
          "path": "/tree",
          "value": {
            "kind": "branch",
            "events": [
              {
                "id": "p0",
                "op": "read_parameter",
                "parameter": "flag"
              }
            ],
            "condition": [
              "eq",
              [
                "arg",
                "flag"
              ],
              [
                "bv",
                32,
                "00000000"
              ]
            ],
            "then": {
              "kind": "leaf",
              "events": [],
              "exit": {
                "kind": "return",
                "code": [
                  "bv",
                  32,
                  "00004000"
                ]
              }
            },
            "else": {
              "kind": "leaf",
              "events": [],
              "exit": {
                "kind": "return",
                "code": [
                  "bv",
                  32,
                  "0000400c"
                ]
              }
            }
          }
        }
      ],
      "witness": {
        "flag": "00000000"
      }
    },
    {
      "id": "read-count-not-cleanup",
      "expected": "equivalent",
      "derived_changes": [],
      "rationale": "两边都只读一个32位参数但回收12字节，模型不能强制二者相等。",
      "base_changes": [
        {
          "op": "replace",
          "path": "/tree/events/2/bytes",
          "value": 12
        }
      ]
    }
  ]
}
